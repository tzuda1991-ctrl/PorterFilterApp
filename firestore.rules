rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogleAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return verifiedGoogleAccount()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if verifiedGoogleAccount() && request.auth.uid == uid;
    }

    function ownGoogleAccount(uid) {
      return verifiedGoogleAccount() && request.auth.uid == uid;
    }

    function driverProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeDriverSession() {
      return verifiedGoogleAccount()
        && driverProfile().status == 'active'
        && driverProfile().sessionAuthTime == request.auth.token.auth_time;
    }

    function validDriverDetails(profile) {
      let catalog = /databases/$(database)/documents/app_config/driver_cities;
      return profile.name is string && profile.name.size() > 0 && profile.name.size() <= 100
        && profile.phone is string && profile.phone.matches('[0-9]{10}')
        && profile.city is string
        && ((!exists(catalog) && profile.city in ['Bengaluru', 'Mumbai', 'Delhi NCR', 'Hyderabad', 'Chennai', 'Pune'])
            || (exists(catalog) && profile.city in get(catalog).data.cities));
    }

    function driverNumberCounter() {
      return /databases/$(database)/documents/counters/driver_numbers;
    }

    function nextDriverNumber() {
      let counter = driverNumberCounter();
      return exists(counter) ? get(counter).data.lastNumber + 1 : 211126;
    }

    function assignsDriverNumber(uid) {
      let counter = getAfter(driverNumberCounter()).data;
      return resource.data.get('driverNumber', 0) == 0
        && resource.data.status != 'deleted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverNumber'])
        && request.resource.data.driverNumber == nextDriverNumber()
        && counter.lastNumber == request.resource.data.driverNumber
        && counter.lastUid == uid;
    }

    function validCounterAssignment() {
      let data = request.resource.data;
      let profile = /databases/$(database)/documents/users/$(data.lastUid);
      return data.keys().hasOnly(['lastNumber', 'lastUid'])
        && data.lastUid is string
        && data.lastNumber is int
        && data.lastNumber == nextDriverNumber()
        && (isAdmin() || (activeDriverSession() && data.lastUid == request.auth.uid))
        && exists(profile)
        && get(profile).data.status != 'deleted'
        && get(profile).data.get('driverNumber', 0) == 0
        && getAfter(profile).data.driverNumber == data.lastNumber;
    }

    match /counters/driver_numbers {
      allow get: if isAdmin() || activeDriverSession();
      allow create, update: if validCounterAssignment();
    }

    match /users/{uid} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && !('driverNumber' in request.resource.data);
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverNumber']);
      allow update: if (isAdmin() || (ownGoogleAccount(uid) && activeDriverSession()))
        && assignsDriverNumber(uid);
      allow get: if ownGoogleAccount(uid) && (
        resource == null || resource.data.sessionAuthTime == request.auth.token.auth_time
        || resource.data.sessionAuthTime == 0
      );
      allow create: if ownGoogleAccount(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'status', 'planName',
          'subscriptionStatus', 'sessionAuthTime', 'validUntil', 'joinedAt', 'phone', 'city'
        ])
        && request.resource.data.uid == uid
        && validDriverDetails(request.resource.data)
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.joinedAt >= request.time - duration.value(5, 'm')
        && request.resource.data.joinedAt <= request.time + duration.value(5, 'm')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.planName == 'TRIAL'
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.sessionAuthTime == request.auth.token.auth_time
        && request.resource.data.validUntil is timestamp
        && request.resource.data.validUntil > request.time
        && request.resource.data.validUntil <= request.time + duration.value(3, 'd') + duration.value(5, 'm');
      allow update: if ownGoogleAccount(uid) && resource.data.status == 'active'
        && resource.data.sessionAuthTime == 0
        && request.auth.token.auth_time > resource.data.sessionResetAfter
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionAuthTime'])
        && request.resource.data.sessionAuthTime == request.auth.token.auth_time;
      allow update: if ownGoogleAccount(uid) && resource.data.status == 'active'
        && resource.data.sessionAuthTime == request.auth.token.auth_time
        && (resource.data.get('name', '') == '' || resource.data.get('phone', '') == '' || resource.data.get('city', '') == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'city'])
        && validDriverDetails(request.resource.data);
    }

    match /app_config/{document} {
      allow get: if (document in ['support', 'driver_cities'] && verifiedGoogleAccount())
        || (activeDriverSession() && document in ['version_control', 'payment_settings']);
    }

    match /area_catalog/{city} {
      allow get: if activeDriverSession() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['areas'])
        && request.resource.data.areas is map
        && request.resource.data.areas.size() <= 5000;
    }

    match /subscription_plans/{plan} {
      allow read: if activeDriverSession();
    }

    function matchesCatalog(plan) {
      let catalog = get(/databases/$(database)/documents/subscription_plans/$(plan.planId)).data;
      return catalog.get('enabled', true) == true && plan.amount == catalog.price && plan.durationDays == catalog.durationDays
        && plan.planName == catalog.name;
    }

    match /payment_requests/{payment} {
      allow read: if activeDriverSession() && resource.data.userId == request.auth.uid;
      allow create: if activeDriverSession()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.id == payment
        && request.resource.data.utrNumber is string
        && request.resource.data.utrNumber.matches('[0-9]{12}')
        && matchesCatalog(request.resource.data);
    }

    match /orders/{order} {
      allow create: if activeDriverSession()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderId == order;
    }

    match /push_accounts/{uid}/push_devices/{installation} {
      allow create, update: if ownGoogleAccount(uid)
        && request.resource.data.keys().hasOnly(['token', 'audience', 'sessionAuthTime'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 2048
        && request.resource.data.sessionAuthTime == request.auth.token.auth_time
        && ((request.resource.data.audience == 'driver' && activeDriverSession())
            || (request.resource.data.audience == 'admin' && isAdmin()));
      allow delete: if ownGoogleAccount(uid);
    }

    match /notification_requests/{id} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind', 'planId'])
        && request.resource.data.kind == 'plan'
        && request.resource.data.planId is string;
    }

    match /telegram_config/settings {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['chatId', 'enabled'])
        && request.resource.data.chatId is string
        && request.resource.data.chatId.matches('^-?[0-9]{1,20}$')
        && request.resource.data.enabled is bool;
    }

    match /telegram_tests/{id} {
      allow get: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status == 'pending';
    }

    match /{collection}/{document} {
      allow read, write: if collection in [
        'orders', 'payment_requests', 'license_keys',
        'app_config', 'subscription_plans'
      ] && isAdmin();
    }
  }
}
